            <title>科学上网環境共有方法</title>
            <link>https://AkuamT.github.io/ja/p/%E7%A7%91%E5%AD%A6%E4%B8%8A%E7%BD%91%E7%8E%AF%E5%A2%83%E5%85%B1%E4%BA%AB%E6%96%B9%E5%BC%8F/</link>
